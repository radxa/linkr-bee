# Build outputs
build/
build-*/
dist/
*.spec

# Python cache
__pycache__/
*.py[cod]

# C reference terminal build output
tools/linkr_ble_terminal_c

# Local logs and captures
*.log
sbc-console*.txt
sbc-console*.log
log_*.txt

# Debug/automation scratch files (serial monitor helpers, patches, etc.)
.tmp_*

# Local tooling state
.reasonix/
# Dependencies installed into the linked agent plugins (npm install linkr-bee-cli)
linkr-bee-dsh/node_modules/
linkr-bee-opencode/node_modules/
# The OpenCode plugin commits its prebuilt UI bundles and ships them in npm, so
# keep them despite the generic dist/ rule above.
!linkr-bee-opencode/dist/
!linkr-bee-opencode/dist/*

# Local screen captures from KVM automation runs
.linkr/

# Mobile app dependencies and generated output
mobile/node_modules/
mobile/dist/
mobile/test-results/
mobile/playwright-report/
harmonyos/dist/
harmonyos/.idea/
harmonyos/.hvigor/
harmonyos/oh_modules/
harmonyos/local.properties
harmonyos/entry/oh_modules/
harmonyos/signing/
# Signing material is per-machine: the tree ships the template, DevEco writes this.
harmonyos/build-profile.json5
harmonyos/**/*.cer
harmonyos/**/*.p12
harmonyos/**/*.p7b

# macOS
.DS_Store

# Python virtualenv
.venv/

# Local design tooling state
.impeccable/

# Binaries built for a machine to try
bin/
# …except an npm package's launcher, which lives in bin/ by npm's own convention.
!tools/linkr-tui/npm/bin/
!tools/linkr-tui/npm/bin/**
# Firmware images and the manifest behind flash.html are staged by
# tools/build_firmware_manifest.py (CI runs it against the release artifacts).
web/firmware/
