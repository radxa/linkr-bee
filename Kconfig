config LINKR_BLE_BRIDGE_CONTROL_COMMANDS
	bool "Enable BLE control commands"
	default y
	help
	  Treat BLE RX writes starting with "@linkr " as bridge control commands
	  instead of forwarding them to UART. Supported commands include:
	  "@linkr uart?" and "@linkr uart=<baud>,<data>,<parity>,<stop>,<flow>".

config LINKR_BLE_BRIDGE_PAIRING_GPIO_AUTH
	bool "Require GPIO button press for BLE pairing"
	default n
	help
	  When enabled, the pairing GPIO (linkr-pairing alias) must be held
	  active before the host can initiate BLE pairing. Set to n to allow
	  pairing without physical button access, e.g. for boards without a
	  dedicated pairing button or during development.

config LINKR_BLE_BRIDGE_BLE_NAME_FROM_MAC
	bool "Dynamic BLE name with hardware-MAC suffix and runtime override"
	depends on BT && SETTINGS
	default y
	select BT_DEVICE_NAME_DYNAMIC
	help
	  Advertise "Linkr Bee XXXX" by default, where XXXX is the last four
	  hex digits of the factory hardware MAC in uppercase (for example
	  58:BF:25:33:07:8C becomes 078C). The name is stable for the life of
	  the board and distinct between units without another stored value.

	  The @n command (or @linkr name) can replace the complete name at
	  runtime. A custom name is persisted in settings and restored across
	  boots; @n default removes it and returns to the hardware-MAC name.
	  Names are 1-29 UTF-8 bytes so they fit a complete legacy
	  advertisement.

	  New firmware is still discovered and verified by the Linkr
	  Management Service UUID and Device ID, never by this display name.
	  Firmware that predates the service keeps its fixed
	  "Linkr BLE UART..." name as a compatibility discovery signal.

