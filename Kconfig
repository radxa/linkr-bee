config LINKR_BLE_BRIDGE_WS_BRIDGE
	bool "Enable UART-over-WebSocket LAN bridge"
	default y
	depends on LINKR_BLE_BRIDGE_WIFI
	select HTTP_SERVER
	select HTTP_SERVER_WEBSOCKET
	help
	  Serve the bridge UART over a WebSocket endpoint (ws://<device-ip>/ws)
	  so LAN clients can use the serial console without BLE range or
	  throughput limits. Binary frames carry raw UART bytes in both
	  directions. The server only runs while WiFi has an IP address and
	  can be toggled at runtime with the "@s on|off|?" control command.

config LINKR_BLE_BRIDGE_WS_BRIDGE_PORT
	int "WebSocket bridge TCP port"
	default 80
	range 1 65535
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS
	int "Maximum simultaneous WebSocket bridge clients"
	default 2
	range 1 4
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_WS_BRIDGE_CLIENT_BUFFER_SIZE
	int "Per-client TX ring buffer size in bytes"
	default 2048
	range 512 16384
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  Bytes of UART RX buffered per WebSocket client. A client slower than
	  the UART drops oldest data instead of blocking the bridge. Any value
	  in this range builds: the buffer is a byte-oriented Zephyr ring
	  buffer, which accepts arbitrary sizes and is never indexed with a
	  power-of-two mask.

config LINKR_BLE_BRIDGE_WS_BRIDGE_AUTH_TOKEN
	string "Optional build-time WebSocket auth token override"
	default ""
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  When empty (the default), the first boot mints a random 128-bit token
	  and stores it in settings. Clients must send the token as their first
	  WebSocket text frame within 3 seconds; on success the bridge replies
	  "@ws auth=ok" before the first UART byte. "@s?" reports the token over
	  the encrypted BLE management channel, "@s token" rotates it, and
	  "@s token=<value>" sets one explicitly.

	  Set this only to pin a provisioning-time token: it must be exactly 32
	  lowercase hex characters. It is used when settings holds no token yet;
	  a token written at runtime by "@s token" or "@s token off" is persisted
	  and takes precedence from the next boot on.
	  The token is LAN access control, not transport security: the socket is
	  plain ws:// and its bytes are visible to the local network.

config LINKR_BLE_BRIDGE_WS_BRIDGE_STACK
	int "WebSocket bridge per-client thread stack size"
	default 4096
	range 1024 8192
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_MGMT_TX_QUEUE_DEPTH
	int "BLE management TX queue depth"
	default 16
	range 16 64
	help
	  Number of management TX messages that can wait for BLE transmission.
	  Messages allocate only their actual payload size. The minimum leaves
	  headroom beyond a full WiFi scan burst (12 results plus completion).

config LINKR_BLE_BRIDGE_MGMT_REQUEST_STACK
	int "BLE management request thread stack size"
	default 4096
	range 1024 8192

# Size Zephyr's shared HTTP/WebSocket resources only when the bridge exists.
# Keeping these defaults here avoids invalid prj.conf assignments in builds
# that intentionally compile the optional service out.
config HTTP_SERVER_MAX_CLIENTS
	default LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS if LINKR_BLE_BRIDGE_WS_BRIDGE

config WEBSOCKET_MAX_CONTEXTS
	default LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS if LINKR_BLE_BRIDGE_WS_BRIDGE

config HTTP_SERVER_VERSION_2
	default n if LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  Linkr only uses the HTTP/1.1 WebSocket upgrade path. Keeping HTTP/2 out
	  avoids reserving its parser, HPACK, and Huffman resources on ESP32-C3.

config HTTP_SERVER_STACK_SIZE
	default 8192 if LINKR_BLE_BRIDGE_WS_BRIDGE

endmenu

source "Kconfig.zephyr"
