config LINKR_BLE_BRIDGE_WS_BRIDGE
	bool "Enable UART-over-WebSocket LAN bridge"
	default y
	depends on LINKR_BLE_BRIDGE_WIFI
	select HTTP_SERVER
	select HTTP_SERVER_WEBSOCKET
	help
	  Serve the bridge UART over a WebSocket endpoint (ws://<device-ip>/ws)
	  so LAN clients can use the serial console without BLE range or
	  throughput limits. Binary frames carry raw UART bytes in both
	  directions. The server only runs while WiFi has an IP address and
	  can be toggled at runtime with the "@s on|off|?" control command.

config LINKR_BLE_BRIDGE_WS_BRIDGE_PORT
	int "WebSocket bridge TCP port"
	default 80
	range 1 65535
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS
	int "Maximum simultaneous WebSocket bridge clients"
	default 2
	range 1 4
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_WS_BRIDGE_CLIENT_BUFFER_SIZE
	int "Per-client TX ring buffer size in bytes"
	default 2048
	range 512 16384
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  Bytes of UART RX buffered per WebSocket client. A client slower than
	  the UART drops oldest data instead of blocking the bridge. Any value
	  in this range builds: the buffer is a byte-oriented Zephyr ring
	  buffer, which accepts arbitrary sizes and is never indexed with a
	  power-of-two mask.

config LINKR_BLE_BRIDGE_WS_BRIDGE_AUTH_TOKEN
	string "Optional build-time WebSocket auth token override"
	default ""
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  When empty (the default), the first boot mints a random 128-bit token
	  and stores it in settings. Clients must send the token as their first
	  WebSocket text frame within 3 seconds; on success the bridge replies
	  "@ws auth=ok" before the first UART byte. "@s?" reports the token over
	  the encrypted BLE management channel, "@s token" rotates it, and
	  "@s token=<value>" sets one explicitly.

	  Set this only to pin a provisioning-time token: it must be exactly 32
	  lowercase hex characters. It is used when settings holds no token yet;
	  a token written at runtime by "@s token" or "@s token off" is persisted
	  and takes precedence from the next boot on.
	  The token is LAN access control, not transport security: the socket is
	  plain ws:// and its bytes are visible to the local network.

config LINKR_BLE_BRIDGE_WS_BRIDGE_STACK
	int "WebSocket bridge per-client thread stack size"
	default 4096
	range 1024 8192
	depends on LINKR_BLE_BRIDGE_WS_BRIDGE

config LINKR_BLE_BRIDGE_MGMT_TX_QUEUE_DEPTH
	int "BLE management TX queue depth"
	default 16
	range 16 64
	help
	  Number of management TX messages that can wait for BLE transmission.
	  Messages allocate only their actual payload size. The minimum leaves
	  headroom beyond a full WiFi scan burst (12 results plus completion).

config LINKR_BLE_BRIDGE_MGMT_REQUEST_STACK
	int "BLE management request thread stack size"
	default 4096
	range 1024 8192

# Size Zephyr's shared HTTP/WebSocket resources only when the bridge exists.
# Keeping these defaults here avoids invalid prj.conf assignments in builds
# that intentionally compile the optional service out.
config HTTP_SERVER_MAX_CLIENTS
	default LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS if LINKR_BLE_BRIDGE_WS_BRIDGE

config WEBSOCKET_MAX_CONTEXTS
	default LINKR_BLE_BRIDGE_WS_BRIDGE_MAX_CLIENTS if LINKR_BLE_BRIDGE_WS_BRIDGE

config HTTP_SERVER_VERSION_2
	default n if LINKR_BLE_BRIDGE_WS_BRIDGE
	help
	  Linkr only uses the HTTP/1.1 WebSocket upgrade path. Keeping HTTP/2 out
	  avoids reserving its parser, HPACK, and Huffman resources on ESP32-C3.

config HTTP_SERVER_STACK_SIZE
	default 8192 if LINKR_BLE_BRIDGE_WS_BRIDGE

# --------------------------------------------------------------------------
# Linkr Bee X1.0 auxiliary board I/O (RGB status LED, optocoupler, IR remote)
# --------------------------------------------------------------------------
# The dev boards and the Super Mini have none of these nodes, so every option
# below collapses to n there and the command group only advertises what the
# board can actually do.

config LINKR_BLE_BRIDGE_RGB_STATUS_LED
	bool "Addressable RGB status LED"
	depends on DT_HAS_RADXA_LINKR_WS2812_ENABLED
	default y
	help
	  Drive the board's WS2812-compatible status LED, and use it for the UART
	  activity indication instead of a plain GPIO LED. The protocol is
	  generated by the application (src/linkr_ws2812.c): Zephyr has no LED
	  strip driver for the ESP32-C3.

config LINKR_BLE_BRIDGE_RGB_ACTIVITY_COLOR
	hex "Status LED colour used for UART activity"
	depends on LINKR_BLE_BRIDGE_RGB_STATUS_LED
	default 0x001830
	range 0x000000 0xFFFFFF
	help
	  Colour of the short flash shown whenever UART traffic moves. Keep it
	  dim: a WS2812 pixel at full white draws about 60 mA.

config LINKR_BLE_BRIDGE_OPTO_SWITCH
	bool "Optocoupler dry-contact switch"
	depends on DT_HAS_RADXA_LINKR_OPTO_SWITCH_ENABLED
	default y
	help
	  Allow the host to close the isolated contact wired across J5, for
	  example to press the target board's reset or power key.

config LINKR_BLE_BRIDGE_IR
	bool "Infrared remote transceiver (NEC)"
	depends on DT_HAS_RADXA_LINKR_IR_ENABLED
	default y
	help
	  Receive NEC frames from an IR remote and transmit them. The receiver
	  decodes the demodulating IR module's output; the transmitter gates a
	  38 kHz carrier generated by LEDC.

config LINKR_BLE_BRIDGE_IR_TX
	bool "Infrared transmitter"
	depends on LINKR_BLE_BRIDGE_IR
	depends on DT_HAS_ESPRESSIF_ESP32_LEDC_ENABLED
	select PWM
	default y
	help
	  Transmit NEC frames. A full frame is about 68 ms of busy-waiting on a
	  cooperative helper thread; the carrier itself is hardware generated,
	  so only interrupts can stretch a mark.

config LINKR_BLE_BRIDGE_IR_RX
	bool "Infrared receiver"
	depends on LINKR_BLE_BRIDGE_IR
	default y
	help
	  Decode NEC frames in the receiver GPIO interrupt handler. The last
	  frame and the receive counters are readable with @r?.

config LINKR_BLE_BRIDGE_AI_CONFIG
	bool "Store the AI configuration on the board"
	depends on SETTINGS
	default y
	help
	  Keep one AI configuration blob (endpoint, model, protocol, limits and,
	  if the user opts in, the API key and extra headers) in NVS so it
	  follows the board instead of one browser. The firmware treats it as
	  opaque bytes; the app owns the schema and validates it on load. A
	  paired host can read the blob over the management channel, so the key
	  is stored only when the user explicitly asks for it.

config LINKR_BLE_BRIDGE_AI_CONFIG_MAX
	int "Maximum AI configuration blob size in bytes"
	depends on LINKR_BLE_BRIDGE_AI_CONFIG
	default 960
	range 240 2048
	help
	  The blob is uploaded in chunks over the management channel; 960 bytes
	  covers a long endpoint, a model id, a token and several headers.

# --------------------------------------------------------------------------
# Paired-device labels
# --------------------------------------------------------------------------
# A bonded host shows up in the paired-device list under its identity address.
# The owner can give it a display label (e.g. "Alice's phone") stored in NVS
# next to the bond; the Bluetooth stack owns the bond table itself and cannot
# carry extra fields, so the two are joined by address.

config LINKR_BLE_BRIDGE_BOND_LABEL_MAX
	int "Maximum paired-device label length in bytes"
	depends on SETTINGS
	default 48
	range 8 64
	help
	  Each pairing can carry a free-text display label (UTF-8) so the owner
	  can tell "my phone" from "that laptop". It is stored in NVS under the
	  bond's identity address and removed with the pairing. 48 bytes fits
	  about sixteen Chinese characters or a full phone name; the label
	  travels as hex over the management channel, so 64 bytes would double
	  to 128 characters on the wire, still inside the 512-byte reply.

	  The web and TUI clients cap their own input at 48 bytes because the
	  reply protocol does not report this value. Keep the default unless
	  those clients are changed too: a smaller value makes their writes
	  fail, and a larger value is unreachable from them.

config LINKR_BLE_BRIDGE_IR_LEARN
	bool "Infrared learning (capture and replay arbitrary remotes)"
	depends on LINKR_BLE_BRIDGE_IR
	depends on LINKR_BLE_BRIDGE_IR_RX
	depends on LINKR_BLE_BRIDGE_IR_TX
	depends on SETTINGS
	default y
	help
	  Capture the raw mark/space train of any IR remote, store it in NVS and
	  replay it later. This covers remotes that are not NEC (RC5, Sony, JVC,
	  ...) as long as one key press fits in the edge budget. Commands are
	  @r learn, @r play, @r slots and @r delete.

config LINKR_BLE_BRIDGE_IR_LEARN_SLOTS
	int "Learned IR command slots"
	depends on LINKR_BLE_BRIDGE_IR_LEARN
	default 8
	range 1 16
	help
	  Number of learned commands kept in NVS. Each slot costs about 400 bytes
	  of NVS space and the same amount of RAM.

config LINKR_BLE_BRIDGE_IR_LEARN_MAX_EDGES
	int "Maximum intervals captured per learned command"
	depends on LINKR_BLE_BRIDGE_IR_LEARN
	default 192
	range 16 512
	help
	  One key press is stored as alternating mark/space intervals. A NEC frame
	  is 67 intervals and RC5 is under 30; 192 also leaves room for the
	  longer Sony and JVC frames. Protocols whose frame does not fit are
	  rejected instead of being truncated.

config LINKR_BLE_BRIDGE_IR_LEARN_NAME_MAX
	int "Maximum saved-command name length in bytes"
	depends on LINKR_BLE_BRIDGE_IR_LEARN
	default 32
	range 8 64
	help
	  Each learned slot can carry a free-text name (UTF-8) so the owner can
	  tell the keys of a multi-button remote apart. The name is stored in NVS
	  next to the waveform and travels with the board; 32 bytes fits about ten
	  Chinese characters or 32 ASCII ones. Names are moved as hex over the
	  management channel to keep spaces and non-ASCII bytes unambiguous.

config LINKR_BLE_BRIDGE_IR_LEARN_IDLE_MS
	int "Silence that ends a learned frame"
	depends on LINKR_BLE_BRIDGE_IR_LEARN
	default 60
	range 20 500
	help
	  The capture closes after the receiver line has been quiet this long,
	  which is how a key press is separated from the next one.

config LINKR_BLE_BRIDGE_IR_LEARN_TIMEOUT_MS
	int "Learning request timeout"
	depends on LINKR_BLE_BRIDGE_IR_LEARN
	default 15000
	range 1000 60000
	help
	  Give up when no usable frame was captured within this time.

endmenu

source "Kconfig.zephyr"
