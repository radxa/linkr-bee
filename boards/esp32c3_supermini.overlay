/ {
	chosen {
		zephyr,linkr-ble-uart = &uart0;
	};

	aliases {
		linkr-factory-reset = &linkr_factory_reset;
	};

	linkr_factory_reset_keys {
		compatible = "gpio-keys";

		/* Hold GPIO0 low (short to GND) during boot to reset ownership. */
		linkr_factory_reset: factory-reset {
			label = "Linkr factory reset";
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Reserve one erase sector for firmware-test markers without touching the
 * board's coredump partition. */
&storage_partition {
	reg = <0x3b0000 0x2f000>;
};

&flash0 {
	partitions {
		linkr_test_marker_partition: partition@3df000 {
			label = "linkr-test-marker";
			reg = <0x3df000 0x1000>;
		};
	};
};

/* Enable the onboard WiFi node. The driver itself is selected only when
 * CONFIG_LINKR_BLE_BRIDGE_WIFI=y, so BLE-only builds keep this inert. */
&wifi {
	status = "okay";
};
