{
  "name": "dsh-linkr-bee",
  "version": "1.2.0",
  "description": "Linkr Bee (BLE/UART wireless serial bridge) as a DeepSeek Harness plugin: a live xterm console in the right column, driven by keystrokes, plus agent tools that run commands on the target board through bee-cli.",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "linkr-bee",
    "serial",
    "uart",
    "console",
    "xterm",
    "ble",
    "bluetooth",
    "embedded"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radxa/linkr-bee.git",
    "directory": "linkr-bee-dsh"
  },
  "homepage": "https://github.com/radxa/linkr-bee/tree/main/linkr-bee-dsh",
  "bugs": {
    "url": "https://github.com/radxa/linkr-bee/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}