{
  "name": "linkr-bee-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "tsc --noEmit && vite build --config vite.config.mjs",
    "build:harmony": "vite build --config ../harmonyos/vite.config.mjs",
    "build:harmony:hap": "../harmonyos/tools/build.sh",
    "test": "node --test test/*.test.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
